# Database Configuration
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=ai_mail_db
DB_PORT=5432

# Server Configuration
BACKEND_PORT=3001
FRONTEND_PORT=80
NODE_ENV=production

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_ACCESS_TOKEN=your_google_access_token_here
GOOGLE_REFRESH_TOKEN=your_google_refresh_token_here

# Mail Configuration
MAIL_USER=your_email@gmail.com
MAIL_APP_PASSWORD=your_app_password_here

# OpenRouter (Optional - for alternative AI models)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL_PRIMARY=deepseek/deepseek-chat-v3-0324
OPENROUTER_MODEL_SECONDARY=qwen/qwen3-32b

# Ollama Configuration
OLLAMA_MODEL=qwen2.5:latest
OLLAMA_PORT=11434
